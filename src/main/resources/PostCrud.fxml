<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="646.0" prefWidth="1054.0" stylesheets="@css/styles.css" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PostCrud">
    <children>
        <Text text="Post Management System" layoutX="360.0" layoutY="30.0" fontSmoothingType="GRAY" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

        <Label layoutX="15.0" layoutY="51.0" text="Author" style="-fx-font-weight: bold;" />
        <Label layoutX="13.0" layoutY="152.0" text="Content" style="-fx-font-weight: bold;" />

        <TextField fx:id="authorTF" layoutX="81.0" layoutY="45.0" prefHeight="33.0" prefWidth="143.0" />
        <TextField fx:id="contentTF" layoutX="81.0" layoutY="162.0" prefHeight="139.0" prefWidth="143.0" />

        <Button layoutX="58.0" layoutY="553.0" text="Add" onAction="#addPost" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" />
        <Button layoutX="526.0" layoutY="507.0" text="Update" onAction="#updatePost" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;" />
        <Button layoutX="344.0" layoutY="505.0" text="Delete" onAction="#deletePost" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;" />

        <TableView fx:id="postTV" layoutX="254.0" layoutY="58.0" prefHeight="370.0" prefWidth="746.0">
            <columns>
                <TableColumn fx:id="authorCOL" text="Author" />
                <TableColumn fx:id="titleCOL" text="Title" />
                <TableColumn fx:id="contentCOL" text="Content" />
                <TableColumn fx:id="cdateCOL" text="Created Date" />
                <TableColumn fx:id="likesCOL" text="Likes" />
                <TableColumn fx:id="dislikesCOL" text="Dislikes" />
            </columns>
        </TableView>

        <Button layoutX="783.0" layoutY="505.0" text="Show Comments" onAction="#showComment" style="-fx-background-color: #ff9800; -fx-text-fill: white; -fx-font-weight: bold;" />

        <Label layoutX="15.0" layoutY="98.0" text="Title" style="-fx-font-weight: bold;" />
        <TextField fx:id="titleTF" layoutX="81.0" layoutY="91.0" prefHeight="33.0" prefWidth="143.0" />

        <Label layoutX="67.0" layoutY="451.0" text="Created Date" style="-fx-font-weight: bold;" />
        <DatePicker fx:id="cdateDP" layoutX="21.0" layoutY="492.0" />

        <Label layoutX="25.0" layoutY="325.0" text="Likes" style="-fx-font-weight: bold;" />
        <TextField fx:id="likesTF" layoutX="91.0" layoutY="319.0" prefHeight="33.0" prefWidth="143.0" />

        <Label layoutX="25.0" layoutY="372.0" text="Dislikes" style="-fx-font-weight: bold;" />
        <TextField fx:id="dislikesTF" layoutX="91.0" layoutY="365.0" prefHeight="33.0" prefWidth="143.0" />
    </children>
</AnchorPane>
